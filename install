#!/bin/bash

# Έλεγχος αν δόθηκε το hostname ως παράμετρος
if [ -z "$1" ]; then
  echo "Χρήση: $0 <hostname>"
  exit 1
fi

HOSTNAME=$1

# Αυτόματη επιλογή ζώνης ώρας
echo 'tzdata tzdata/Areas select Europe' | debconf-set-selections
echo 'tzdata tzdata/Zones/Europe select Athens' | debconf-set-selections

# Ορισμός του DEBIAN_FRONTEND για μη διαδραστική εγκατάσταση
export DEBIAN_FRONTEND=noninteractive

# Ενημέρωση και εγκατάσταση των απαραίτητων πακέτων
apt update
apt upgrade -y
apt install -y caddy git ffmpeg ufw curl

# Ενεργοποίηση του firewall
ufw allow 22
ufw allow 80
ufw allow 443
ufw allow 8000
ufw allow 1935
ufw default deny incoming
ufw default allow outgoing
ufw --force enable

# Εγκατάσταση volta.sh (το node:sqlite του admin θέλει node 24)
curl https://get.volta.sh | bash
export VOLTA_HOME="$HOME/.volta"
export PATH="$VOLTA_HOME/bin:$PATH"
sleep 3
volta install node@24
volta install npm@bundled

# Κλωνοποίηση και εγκατάσταση του stream server
git clone https://github.com/pointergr/node-media-server.git
cd node-media-server
npm install

# Εγκατάσταση του pm2
npm install pm2 -g

# Παραγωγή κωδικών
npm run generate-passwords $HOSTNAME

# Ρύθμιση Caddy — χρειάζεται τον admin κωδικό, γι' αυτό τρέχει μετά το generate-passwords
mkdir -p /var/log/caddy
chown caddy:caddy /var/log/caddy

ADMIN_PASS=$(node -e "console.log(JSON.parse(require('fs').readFileSync('passwords.json')).adminPassword)")
ADMIN_HASH=$(caddy hash-password --plaintext "$ADMIN_PASS")

cat <<EOF > /etc/caddy/Caddyfile
{
        # runtime errors: certificates, ACME, config
        log {
                output file /var/log/caddy/error.log
                level ERROR
        }
}

# Χωρίς scheme ο Caddy εξυπηρετεί και τα δύο: βγάζει μόνος του certificate, ακούει
# στο 443 και κάνει redirect 80->443. Θέλει Cloudflare SSL mode Full — με Flexible
# το CF χτυπάει το origin σε http και ο redirect γίνεται loop.
$HOSTNAME, rtmp.$HOSTNAME {
        # Το admin UI ακούει μόνο στο loopback — το auth το κάνει εδώ ο Caddy
        handle /admin* {
                # basicauth, όχι basic_auth: το νέο όνομα δεν υπάρχει πριν τον Caddy 2.8,
                # ενώ το παλιό δουλεύει και στις δύο (με deprecation warning στις νέες)
                basicauth {
                        admin $ADMIN_HASH
                }
                reverse_proxy localhost:8001
        }

        handle {
                reverse_proxy localhost:8000
        }

        # HLS: το playlist δεν πρέπει ποτέ να κασάρεται, τα segments είναι immutable
        @m3u8 path *.m3u8
        @ts path *.ts
        header @m3u8 Cache-Control "no-store"
        header @ts Cache-Control "public, max-age=31536000, immutable"

        # Οι online HLS players τρέχουν σε άλλο origin — χωρίς αυτό το hls.js
        # μπλοκάρεται από τον browser και δεν βλέπει ούτε segments ούτε bitrates
        @hls path *.m3u8 *.ts
        header @hls Access-Control-Allow-Origin "*"

        log {
                output file /var/log/caddy/access.log
        }
}
EOF

# Επανεκκίνηση του Caddy για να εφαρμοστούν οι αλλαγές
systemctl restart caddy

# Ξεκινάμε τον server σαν pm2 process
pm2 start app.js --name stream

# Μήνυμα ολοκλήρωσης
echo "Ο streaming server εγκαταστάθηκε και ξεκίνησε επιτυχώς!"
