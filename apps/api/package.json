{
  "name": "@pointer/api",
  "version": "0.1.0",
  "description": "NestJS API: κεντρική διαχείριση πολλών stream servers",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "start": "node --env-file=.env dist/src/main.js",
    "start:dev": "nest start --watch",
    "seed": "node --env-file=.env dist/src/seed.js",
    "test": "nest build && node --test dist/test/*.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.29",
    "@nestjs/core": "^11.1.29",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.29",
    "@prisma/client": "6.19.3",
    "prisma": "6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "typescript": "5.9.3"
  },
  "volta": {
    "node": "24.19.0"
  }
}
