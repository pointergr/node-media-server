# cp .env.example .env
#
# Τοπικά (χωρίς Docker, `npm start`): διαβάζονται από `node --env-file=.env`.
# Προσοχή στο `../`: τα σχετικά sqlite paths λύνονται ως προς το schema.prisma
# (apps/api/prisma/), όχι ως προς το cwd. Με `file:./data/api.db` η βάση πάει στο
# apps/api/prisma/data/ — σε Docker αυτό είναι έξω από το volume και χάνεται.
DATABASE_URL="file:../data/api.db"
PORT=3000
#
# Και τα δύο: ίδιο JWT_SECRET σε κάθε restart, αλλιώς αποσυνδέονται όλοι —
# δεν παράγεται μόνο του. Με Docker το docker-compose.yml διαβάζει το ίδιο .env
# για interpolation (DOMAIN, JWT_SECRET) — το DATABASE_URL/PORT εκεί τα δίνει
# ήδη το compose (environment:) και δεν χρειάζονται εδώ.
JWT_SECRET="βάλε-κάτι-τυχαίο-εδώ"
DOMAIN=panel.example.com
#
# Μόνο αν στο ίδιο VPS τρέχει και stream server (docker-compose.override.yml):
# ο Caddy εδώ σερβίρει και το domain του — δύο Caddy δεν χωράνε στο 80/443.
STREAM_DOMAIN=stream.example.com
