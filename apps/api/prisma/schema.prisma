// Ελάχιστο μοντέλο: πελάτες, paths, servers, χρήστες. Το ιστορικό (θεατές,
// bitrate) μένει στο sqlite κάθε stream server — εδώ κρατάμε μόνο ό,τι
// χρειάζεται το panel για να αποφασίζει «ποιος εκπέμπει πού».
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Server {
  id        Int       @id @default(autoincrement())
  host      String    @unique
  // Bearer token που στέλνει ο stream server στο POST /servers/:host/sync.
  token     String
  adminUrl  String
  adminUser String
  adminPass String
  lastSeen  DateTime?
  packages  Package[]
  owned     ClientPackage[]
  paths     Path[]
}

model Client {
  id       Int      @id @default(autoincrement())
  name     String   @unique
  disabled Boolean  @default(false)
  paths    Path[]
  users    User[]
  // Ο πελάτης ΔΕΝ έχει server: ούτε όρια, ούτε μηχάνημα. Και τα δύο βγαίνουν από
  // τις αγορές του (ClientPackage) — ένας πελάτης μπορεί να κάθεται σε δύο
  // servers ταυτόχρονα, ένα πακέτο στον καθένα.
  packages ClientPackage[]
}

// Ό,τι πουλάμε: όρια θεατών και πλήθους streams. Τα νούμερα είναι ≥1 — «πακέτο
// του μηδενός» δεν πουλάει κανείς, και θα ζητούσε τον κανόνα «0 = απεριόριστο»
// μέσα σε άθροισμα (100 + 0 = ∞), που κανείς δεν θα θυμόταν στις 3 τη νύχτα.
// Απεριόριστος πελάτης = πελάτης χωρίς πακέτα.
model Package {
  id         Int             @id @default(autoincrement())
  name       String          @unique
  maxViewers Int
  // Μετράει paths, δηλαδή πόσα streams μπορεί να ΕΧΕΙ ο πελάτης — όχι πόσα
  // εκπέμπουν ταυτόχρονα. Επιβάλλεται στο POST /clients/:id/paths.
  maxStreams Int
  // Πού πέφτουν οι ΝΕΕΣ αγορές αυτού του πακέτου — «το basic πουλάει σήμερα
  // stream2». Αλλάζοντάς το δεν μετακομίζει κανείς: οι παλιές αγορές κρατούν
  // τον δικό τους server (ClientPackage.serverId). Έτσι γεμίζει ένα μηχάνημα
  // και ο επόμενος πελάτης πάει στο επόμενο, χωρίς να πειραχτεί ο προηγούμενος.
  serverId   Int
  server     Server          @relation(fields: [serverId], references: [id])
  clients    ClientPackage[]
}

// Η αγορά: ρητό μοντέλο σύνδεσης και όχι implicit many-to-many, γιατί κρατάει
// δικά της πεδία — ποσότητα και τον server της στιγμής που έγινε.
model ClientPackage {
  clientId  Int
  packageId Int
  qty       Int     @default(1)
  // Στιγμιότυπο του Package.serverId τη στιγμή της αγοράς — γι' αυτό είναι και
  // μέρος του κλειδιού: «2× basic στον stream1» και «1× basic στον stream2»
  // είναι δύο διαφορετικές γραμμές του ίδιου πελάτη.
  serverId  Int
  server    Server  @relation(fields: [serverId], references: [id])
  // Cascade μόνο προς τον πελάτη: σβήνοντας πελάτη φεύγουν οι γραμμές του, όπως
  // ήδη τα paths του. Το πακέτο προστατεύεται αλλού (409 αν το χρησιμοποιεί
  // κάποιος) — αλλιώς μια διαγραφή θα άλλαζε σιωπηλά όρια πελατών.
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  package   Package @relation(fields: [packageId], references: [id])

  @@id([clientId, packageId, serverId])
}

model Path {
  id       Int    @id @default(autoincrement())
  path     String
  // Τυχαίο κλειδί εκπομπής (≥16 chars, base64url) — δες clients.service.ts.
  key      String
  clientId Int
  // Cascade: σβήνοντας πελάτη φεύγουν και τα paths/κλειδιά του. Χωρίς αυτό το
  // DELETE /clients/:id έσκαγε με FK constraint σε κάθε πελάτη που είχε path —
  // δηλαδή σε κάθε πραγματικό πελάτη.
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Ο server του path: ένα από τα μηχανήματα όπου ο πελάτης έχει αγορά. Είναι
  // και το unique σε επίπεδο server, όχι πελάτη: δύο πελάτες του ίδιου server
  // δεν μπορούν να διεκδικήσουν το ίδιο path.
  serverId Int
  server   Server @relation(fields: [serverId], references: [id])

  @@unique([serverId, path])
}

model User {
  id       Int     @id @default(autoincrement())
  username String  @unique
  // scryptSync hash, μορφή "salt:hash" (δες auth/password.ts) — όχι bcrypt,
  // ώστε να μη χρειάζεται native dependency στο image.
  password String
  role     String // "admin" | "customer"
  // null για admin· ο customer βλέπει μόνο τα paths του δικού του πελάτη.
  clientId Int?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
}
